# Test Environment Variables
# Copy this file to .env.test and adjust values as needed.
# The .env.test file is git-ignored to prevent accidental credential leaks.
# All values below are placeholders — replace only when running tests locally.

# Server Configuration
NODE_ENV=test

# Authentication (placeholder values — do not use real secrets)
JWT_SECRET=test-secret
INTERNAL_API_KEY=test-api-key
