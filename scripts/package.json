{
  "name": "remitlend-scripts",
  "version": "1.0.0",
  "description": "Deployment and maintenance scripts for RemitLend contracts",
  "main": "index.js",
  "scripts": {
    "deploy": "ts-node deploy.ts",
    "typecheck": "tsc --noEmit",
    "gen:money": "ts-node gen-money.ts",
    "gen:money:check": "ts-node gen-money.ts --check",
    "test:env-docs": "node check-env-docs.test.mjs",
    "money:property-test": "tsx money-property-test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.4.3",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "axios": "1.13.5"
  }
}
